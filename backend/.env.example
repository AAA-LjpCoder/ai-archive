# ===== AI档案室 环境变量示例 =====
# 复制为 .env 并填写真实值

# 数据库（PostgreSQL + pgvector）
DATABASE_URL=postgresql+psycopg2://aiarchive:aiarchive_dev_pw@localhost:5432/aiarchive

# LLM —— 问答生成（OpenAI 兼容，主用 DeepSeek）
LLM_API_KEY=your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量 / 精排 / 视觉 OCR（OpenAI 兼容，智谱 BigModel）
EMBEDDING_API_KEY=your-zhipu-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# 微信登录（公众平台 → 开发管理）
WECHAT_APP_ID=your-appid
WECHAT_APP_SECRET=your-appsecret
TOKEN_SECRET=change-me-to-a-random-48-chars

# 文件存储目录（相对 backend/ 或绝对路径）
UPLOAD_DIR=./data/uploads

# 应用
APP_ENV=dev
# 仅非生产环境（dev/local/test）无 token 时的回落身份；生产（prod）一律强制 token，忽略此值
SINGLE_USER_OPENID=dev_user
