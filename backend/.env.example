# ===== AI档案室 环境变量示例 =====
# 复制为 .env 并填写真实值

# 数据库
DATABASE_URL=postgresql+psycopg2://aiarchive:aiarchive_dev_pw@localhost:5432/aiarchive

# LLM（OpenAI 兼容接口，主用 DeepSeek）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding（OpenAI 兼容接口，先用硅基流动 BGE-M3，零运维）
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 文件存储目录（相对 backend/ 或绝对路径）
UPLOAD_DIR=./data/uploads

# 应用
APP_ENV=dev
# M1 单用户模式：固定 openid；M2 接入微信登录后改为 false
SINGLE_USER_OPENID=dev_user
