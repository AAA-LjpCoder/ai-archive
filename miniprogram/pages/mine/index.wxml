<view class="page">
  <view class="card">
    <view class="avatar-line">
      <view class="avatar">🍊</view>
      <view>
        <view class="name">AI档案室</view>
        <view class="sub-text">私人知识库 · v0.1</view>
      </view>
    </view>
  </view>

  <view class="card" bindtap="goQuota">
    <view class="menu-line">
      <text>📊 我的额度</text>
      <text class="arrow">›</text>
    </view>
    <view class="sub-text" wx:if="{{quota}}">
      今日问答 {{quota.used}}/{{quota.limit}} 轮 · 文档 {{quota.docs}}/{{quota.docs_limit}} 个
    </view>
  </view>

  <view class="card" bindtap="goPrivacy">
    <view class="menu-line">
      <text>🔒 隐私与数据</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-line">
      <text>📞 反馈</text>
      <text class="arrow">›</text>
    </view>
    <view class="sub-text">自用阶段：直接微信联系开发者</view>
  </view>

  <view class="footer">AI档案室 · 上传即问，回答必带出处</view>
</view>
