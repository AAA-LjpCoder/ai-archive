/* pages/mine/index.wxss */
.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(20, 107, 90, 0.25);
}
.name { font-size: 32rpx; font-weight: 600; margin-bottom: 4rpx; }

.menu { padding: 24rpx 32rpx; }
.menu-line {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 30rpx;
}
.arrow { color: #C9C2B4; font-size: 36rpx; }
.footer { text-align: center; color: #C9C2B4; font-size: 24rpx; margin-top: 60rpx; }
