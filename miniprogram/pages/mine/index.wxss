/* pages/mine/index.wxss — 我的 V2 */
.page { padding-bottom: 80rpx; }

/* 个人档案卡 */
.profile {
  display: flex; align-items: center; gap: 26rpx;
  background: linear-gradient(135deg, #E9F3EE, #F5F0E2);
  border: 1rpx solid rgba(20, 107, 90, 0.08);
  overflow: hidden;
  position: relative;
}
.profile-deco {
  position: absolute; right: -40rpx; top: -40rpx;
  width: 180rpx; height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(20,107,90,0.10), transparent 70%);
}
.avatar {
  width: 92rpx; height: 92rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(20, 107, 90, 0.3);
  position: relative; z-index: 1;
}
.profile-info { position: relative; z-index: 1; }
.name { font-size: 34rpx; font-weight: 700; margin-bottom: 4rpx; }

/* 数据概览条 */
.stats {
  display: flex; align-items: center;
  background: #fff;
  border-radius: 26rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 6rpx 22rpx rgba(45, 42, 38, 0.06);
}
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 800; color: #146B5A; }
.stat-unit { font-size: 24rpx; font-weight: 400; color: #9B9488; }
.stat-label { font-size: 22rpx; color: #9B9488; margin-top: 6rpx; }
.stat-divider { width: 1rpx; height: 48rpx; background: #EFEBE4; }

/* 菜单 */
.menu {
  display: flex; align-items: center; gap: 22rpx;
  padding: 28rpx 30rpx;
}
.menu-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.mi-gold { background: #F7EFE3; }
.mi-green { background: #E3EFEA; }
.mi-brown { background: #F1EDE7; }
.menu-main { flex: 1; min-width: 0; }
.menu-title { font-size: 30rpx; font-weight: 500; margin-bottom: 4rpx; }
.arrow { color: #C9C2B4; font-size: 40rpx; flex-shrink: 0; }

.footer { text-align: center; color: #C9C2B4; font-size: 24rpx; margin-top: 70rpx; }
