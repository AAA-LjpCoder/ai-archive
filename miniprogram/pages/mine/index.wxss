.avatar-line { display: flex; align-items: center; gap: 20rpx; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #E8F0FE; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.name { font-size: 32rpx; font-weight: 600; }

.menu-line {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 30rpx; padding: 8rpx 0;
}
.arrow { color: #C9CDD4; font-size: 36rpx; }
.footer { text-align: center; color: #C9CDD4; font-size: 24rpx; margin-top: 60rpx; }
