/* pages/chat/detail.wxss */
.chat-page { display: flex; flex-direction: column; height: 100vh; }

.mode-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 24rpx; background: #fff;
  border-bottom: 1rpx solid #EFEBE4;
}
.search-only { display: flex; align-items: center; }

.msg-list {
  flex: 1;
  min-height: 0; /* 关键：flex 容器不设 min-height:0 时会被内容撑开，把输入栏挤出屏幕 */
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.welcome { text-align: center; margin-top: 140rpx; color: #9B9488; }
.welcome-title { font-size: 32rpx; font-weight: 600; color: #2D2A26; margin-bottom: 8rpx; }

.msg { display: flex; margin-bottom: 24rpx; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg-user .bubble {
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.msg-ai .bubble {
  background: #fff;
  border: 1rpx solid #EFEBE4;
  border-left: 6rpx solid #146B5A;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 10rpx rgba(45, 42, 38, 0.04);
}

.streaming-dot { color: #9B9488; }

/* 思考中三点跳动动画 */
.thinking { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 0; }
.thinking .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #146B5A;
  animation: blink 1.2s infinite ease-in-out;
}
.thinking .dot:nth-child(2) { animation-delay: 0.2s; }
.thinking .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* 快捷提问卡片 */
.quick-list { margin-top: 48rpx; }
.quick-item {
  background: #fff;
  border: 1rpx solid #EFEBE4;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin: 0 40rpx 20rpx;
  font-size: 28rpx;
  color: #146B5A;
  box-shadow: 0 2rpx 10rpx rgba(45, 42, 38, 0.04);
  text-align: left;
}
.quick-item:active { background: #F2F7F5; }

.cites { margin-top: 16rpx; border-top: 1rpx solid #EFEBE4; padding-top: 12rpx; }
.cite-title { font-size: 22rpx; color: #146B5A; font-weight: 600; margin-bottom: 8rpx; }
.cite-item {
  display: flex; align-items: center; padding: 8rpx 0;
  font-size: 24rpx; color: #146B5A; overflow: hidden;
}
.cite-idx { margin-right: 8rpx; font-weight: 600; color: #B7791F; }
.cite-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cite-page { color: #9B9488; margin-left: 8rpx; }

.input-bar {
  display: flex; align-items: flex-end; gap: 16rpx;
  padding: 16rpx 24rpx; background: #fff;
  border-top: 1rpx solid #EFEBE4;
}
.input-box {
  flex: 1; min-height: 72rpx; max-height: 200rpx;
  background: #F3EFE9; border-radius: 16rpx;
  padding: 16rpx; font-size: 28rpx;
}
.send-btn {
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  padding: 20rpx 36rpx; border-radius: 14rpx; font-size: 28rpx;
  flex-shrink: 0;
}
