.chat-page { display: flex; flex-direction: column; height: 100vh; }

.mode-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 24rpx; background: #fff;
}
.search-only { display: flex; align-items: center; }

.msg-list { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }
.welcome { text-align: center; margin-top: 120rpx; color: #8A9099; }
.welcome-icon { font-size: 72rpx; margin-bottom: 16rpx; }

.msg { display: flex; margin-bottom: 24rpx; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg-user .bubble { background: #1F6FEB; color: #fff; border-top-right-radius: 4rpx; }
.msg-ai .bubble { background: #fff; border-top-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }

.streaming-dot { color: #8A9099; }

.cites { margin-top: 16rpx; border-top: 2rpx solid #EEF0F3; padding-top: 12rpx; }
.cite-title { font-size: 22rpx; color: #8A9099; margin-bottom: 8rpx; }
.cite-item {
  display: flex; align-items: center; padding: 8rpx 0;
  font-size: 24rpx; color: #1F6FEB; overflow: hidden;
}
.cite-idx { margin-right: 8rpx; font-weight: 600; }
.cite-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cite-page { color: #8A9099; margin-left: 8rpx; }

.input-bar {
  display: flex; align-items: flex-end; gap: 16rpx;
  padding: 16rpx 24rpx; background: #fff;
  border-top: 2rpx solid #EEF0F3;
}
.input-box {
  flex: 1; min-height: 72rpx; max-height: 200rpx;
  background: #F5F7FA; border-radius: 12rpx;
  padding: 16rpx; font-size: 28rpx;
}
.send-btn {
  background: #1F6FEB; color: #fff;
  padding: 20rpx 36rpx; border-radius: 12rpx; font-size: 28rpx;
  flex-shrink: 0;
}
