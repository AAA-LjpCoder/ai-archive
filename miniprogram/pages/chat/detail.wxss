/* pages/chat/detail.wxss — 对话页 V2 */
.chat-page { display: flex; flex-direction: column; height: 100vh; background: #FAF8F5; }

/* ---------- 模式栏 ---------- */
.mode-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid #EFEBE4;
}
.mode-label { display: flex; align-items: center; gap: 10rpx; }
.mode-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #146B5A; box-shadow: 0 0 0 4rpx rgba(20,107,90,0.12); }
.search-only { display: flex; align-items: center; }

/* ---------- 消息列表 ---------- */
.msg-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 30rpx;
  box-sizing: border-box;
}

/* ---------- 欢迎页 ---------- */
.welcome { text-align: center; margin-top: 90rpx; animation: fadeUp 0.5s ease both; }
.welcome-title { font-size: 36rpx; font-weight: 700; color: #2D2A26; margin-bottom: 10rpx; letter-spacing: 1rpx; }

.welcome-art { position: relative; width: 140rpx; height: 150rpx; margin: 0 auto 30rpx; }
.wa-box {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 108rpx; height: 126rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #E9F3EE, #F5F0E2);
  border: 3rpx solid rgba(20, 107, 90, 0.18);
  box-shadow: 0 14rpx 30rpx rgba(20, 107, 90, 0.14);
}
.wa-tag {
  position: absolute; right: 20rpx; top: 8rpx;
  width: 42rpx; height: 28rpx;
  background: linear-gradient(180deg, #D99A3D, #B7791F);
  border-radius: 8rpx 8rpx 0 0;
}
.wa-line {
  position: absolute; left: 50%; transform: translateX(-50%);
  height: 6rpx; border-radius: 3rpx;
  background: rgba(20, 107, 90, 0.2);
}
.wa-line.w1 { bottom: 52rpx; width: 60rpx; }
.wa-line.w2 { bottom: 34rpx; width: 44rpx; }

/* 快捷提问 */
.quick-list { margin-top: 48rpx; }
.quick-item {
  display: flex; align-items: center; gap: 14rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #EFEBE4;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  margin: 0 36rpx 20rpx;
  font-size: 28rpx;
  color: #146B5A;
  box-shadow: 0 6rpx 18rpx rgba(45, 42, 38, 0.05);
  text-align: left;
  transition: transform 0.15s ease;
}
.quick-item:active { transform: scale(0.98); background: #F2F7F5; }
.qi-mark { color: #B7791F; font-size: 24rpx; }

/* ---------- 消息 ---------- */
.msg { display: flex; margin-bottom: 26rpx; animation: fadeUp 0.3s ease both; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; flex-wrap: wrap; }

/* AI 侧档案盒小图标 */
.msg-avatar {
  position: relative; width: 60rpx; height: 66rpx;
  flex-shrink: 0; margin-right: 14rpx; margin-top: 8rpx;
}
.av-box {
  position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
  width: 44rpx; height: 50rpx;
  border-radius: 8rpx;
  background: linear-gradient(160deg, #146B5A, #1E8873);
  box-shadow: 0 4rpx 10rpx rgba(20, 107, 90, 0.3);
}
.av-tag {
  position: absolute; right: 2rpx; top: 0;
  width: 18rpx; height: 12rpx;
  background: #D99A3D;
  border-radius: 4rpx 4rpx 0 0;
}

/* 气泡 */
.bubble {
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
  position: relative;
}
.msg-user .bubble {
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 8rpx 20rpx rgba(20, 107, 90, 0.22);
}
.msg-ai .bubble {
  background: #fff;
  border: 1rpx solid #EFEBE4;
  border-left: 8rpx solid #146B5A;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(45, 42, 38, 0.06);
}

/* AI 回答操作栏（赞/踩/复制/重新生成） */
.msg-actions {
  display: flex; align-items: center; gap: 16rpx;
  width: calc(100% - 74rpx);
  margin-left: 74rpx;
  padding: 8rpx 4rpx 0;
  box-sizing: border-box;
}
.act {
  font-size: 22rpx; color: #A8A296;
  padding: 6rpx 14rpx; border-radius: 10rpx;
  transition: color 0.15s ease, background 0.15s ease;
}
.act:active { color: #146B5A; background: rgba(20, 107, 90, 0.08); }
.act-like { color: #146B5A; font-weight: 600; background: rgba(20, 107, 90, 0.08); }
.act-dislike { color: #B4492E; font-weight: 600; background: rgba(176, 73, 46, 0.08); }
.act-regen { color: #B7791F; margin-left: auto; }
.act-regen:active { color: #B7791F; background: rgba(183, 121, 31, 0.1); }

/* 流式打字光标 */
.caret {
  display: inline-block;
  width: 3rpx; height: 30rpx;
  background: #146B5A;
  margin-left: 4rpx; vertical-align: -4rpx;
  animation: blink 0.9s infinite steps(1);
}
@keyframes blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }

/* 思考中三点 */
.thinking { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 0; }
.thinking .dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #146B5A;
  animation: dotBlink 1.2s infinite ease-in-out;
}
.thinking .dot:nth-child(2) { animation-delay: 0.2s; }
.thinking .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBlink {
  0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* ---------- 引用胶囊 ---------- */
.cites {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E5DFD2;
  display: flex; flex-wrap: wrap; gap: 12rpx;
}
.cite-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 16rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #F2F7F5;
  border: 1rpx solid rgba(20, 107, 90, 0.18);
  font-size: 22rpx; color: #146B5A;
  max-width: 100%;
  transition: background 0.15s ease;
}
.cite-item:active { background: #E3EFEA; }
.cite-idx {
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D99A3D, #B7791F);
  color: #fff;
  font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.cite-name { max-width: 220rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cite-page { color: #9B9488; font-size: 20rpx; }

/* ---------- 输入栏 ---------- */
.input-bar {
  display: flex; align-items: flex-end; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #EFEBE4;
}
.input-box {
  flex: 1; min-height: 76rpx; max-height: 200rpx;
  background: #F3EFE9;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.send-btn {
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  padding: 22rpx 40rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(20, 107, 90, 0.25);
  display: flex; align-items: center; justify-content: center;
  min-width: 120rpx;
  transition: transform 0.12s ease;
}
.send-btn:active { transform: scale(0.95); }
.send-dots { display: flex; gap: 6rpx; }
.sd {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #fff;
  animation: dotBlink 1s infinite ease-in-out;
}
.sd:nth-child(2) { animation-delay: 0.15s; }
.sd:nth-child(3) { animation-delay: 0.3s; }

/* 附件按钮（会话框左侧 +） */
.attach-btn {
  width: 76rpx; height: 76rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #EAF2EF;
  border: 2rpx solid #CDE3DC;
  border-radius: 20rpx;
  transition: opacity 0.15s ease;
}
.attach-btn:active { opacity: 0.7; }
.attach-plus { font-size: 44rpx; font-weight: 300; color: #146B5A; line-height: 1; }
