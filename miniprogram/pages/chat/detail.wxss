/* pages/chat/detail.wxss */
.chat-page { display: flex; flex-direction: column; height: 100vh; }

.mode-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 24rpx; background: #fff;
  border-bottom: 1rpx solid #F0F0EE;
}
.search-only { display: flex; align-items: center; }

.msg-list { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }
.welcome { text-align: center; margin-top: 140rpx; color: #9B9A97; }
.welcome-title { font-size: 32rpx; font-weight: 600; color: #37352F; margin-bottom: 8rpx; }

.msg { display: flex; margin-bottom: 24rpx; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg-user .bubble { background: #2383E2; color: #fff; }
.msg-ai .bubble { background: #fff; border: 1rpx solid #EBEBE7; }

.streaming-dot { color: #9B9A97; }

.cites { margin-top: 16rpx; border-top: 1rpx solid #F0F0EE; padding-top: 12rpx; }
.msg-user .cites { border-top-color: rgba(255,255,255,0.3); }
.cite-title { font-size: 22rpx; color: #9B9A97; margin-bottom: 8rpx; }
.cite-item {
  display: flex; align-items: center; padding: 8rpx 0;
  font-size: 24rpx; color: #2383E2; overflow: hidden;
}
.msg-user .cite-item { color: #fff; }
.cite-idx { margin-right: 8rpx; font-weight: 600; }
.cite-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cite-page { color: #9B9A97; margin-left: 8rpx; }
.msg-user .cite-page { color: rgba(255,255,255,0.8); }

.input-bar {
  display: flex; align-items: flex-end; gap: 16rpx;
  padding: 16rpx 24rpx; background: #fff;
  border-top: 1rpx solid #F0F0EE;
}
.input-box {
  flex: 1; min-height: 72rpx; max-height: 200rpx;
  background: #F7F7F5; border-radius: 8rpx;
  padding: 16rpx; font-size: 28rpx;
}
.send-btn {
  background: #2383E2; color: #fff;
  padding: 20rpx 36rpx; border-radius: 6rpx; font-size: 28rpx;
  flex-shrink: 0;
}
