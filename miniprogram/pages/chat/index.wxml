<view class="page">
  <view class="hero">
    <view>
      <view class="hero-title">问答</view>
      <view class="hero-sub">向资料库提问 · 回答带引用出处</view>
    </view>
    <view class="hero-art">
      <view class="art-box"></view>
      <view class="art-tag"></view>
      <view class="art-line l1"></view>
      <view class="art-line l2"></view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}">
    <view class="card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton sk-icon"></view>
      <view class="sk-main">
        <view class="skeleton sk-line w70"></view>
        <view class="skeleton sk-line w40"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{convs.length === 0}}" class="empty">
    <view class="empty-art">
      <view class="ea-box"></view>
      <view class="ea-line l1"></view>
      <view class="ea-line l2"></view>
      <view class="ea-line l3"></view>
      <view class="ea-corner"></view>
    </view>
    <view class="empty-text">还没有会话</view>
    <view class="sub-text">点右下角按钮开始提问</view>
  </view>

  <view wx:for="{{convs}}" wx:key="id" class="card conv anim-up" style="animation-delay: {{index * 50}}ms"
        data-id="{{item.id}}" data-mode="{{item.mode}}" bindtap="openConversation">
    <view class="conv-icon">
      <view class="ci-line"></view>
      <view class="ci-line ci-line-short"></view>
    </view>
    <view class="conv-main">
      <view class="conv-title">{{item.title}}</view>
      <view class="sub-text">{{item.updated_at}}</view>
    </view>
    <view class="conv-actions">
      <view wx:if="{{item.mode === 'doc'}}" class="tag tag-gold">单文档</view>
      <view class="del-btn" catchtap="deleteConversation" data-id="{{item.id}}">删除</view>
    </view>
  </view>

  <view class="fab" bindtap="newConversation">＋ 新问答</view>
</view>
