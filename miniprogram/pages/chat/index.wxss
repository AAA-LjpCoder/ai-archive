/* pages/chat/index.wxss */
.page { padding-bottom: 160rpx; }

.empty { text-align: center; padding: 100rpx 28rpx 60rpx; }
.empty-text { font-size: 32rpx; font-weight: 600; margin: 0 0 8rpx; }

.conv {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #EFEBE4;
}
.conv:active { background: #F4F1EB; }
.conv-title { font-size: 30rpx; margin-bottom: 6rpx; }
.conv-actions { display: flex; align-items: center; }
.del-btn { color: #B4492E; font-size: 24rpx; margin-left: 16rpx; padding: 8rpx; }

.fab {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  font-size: 30rpx;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 107, 90, 0.3);
}
.fab:active { opacity: 0.9; }
