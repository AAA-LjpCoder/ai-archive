.page { padding-bottom: 160rpx; }
.empty { text-align: center; padding: 80rpx 28rpx; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 32rpx; font-weight: 600; margin: 20rpx 0 8rpx; }

.conv { display: flex; align-items: center; justify-content: space-between; }
.conv-title { font-size: 30rpx; font-weight: 500; margin-bottom: 8rpx; }
.conv-actions { display: flex; align-items: center; }
.del-btn { color: #D92D20; font-size: 24rpx; margin-left: 16rpx; padding: 8rpx; }

.fab {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1F6FEB;
  color: #fff;
  font-size: 30rpx;
  padding: 22rpx 60rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 111, 235, 0.35);
}
