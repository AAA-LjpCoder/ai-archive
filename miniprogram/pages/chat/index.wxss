/* pages/chat/index.wxss — 会话列表 V2 */
.page { padding-bottom: 200rpx; }

.empty { text-align: center; padding: 100rpx 28rpx 60rpx; }

/* 骨架屏 */
.skeleton-card { display: flex; align-items: center; padding: 28rpx; }
.sk-icon { width: 76rpx; height: 76rpx; border-radius: 18rpx; flex-shrink: 0; margin-right: 24rpx; }
.sk-main { flex: 1; }
.sk-line { height: 28rpx; margin-bottom: 16rpx; }
.sk-line.w70 { width: 70%; }
.sk-line.w40 { width: 40%; margin-bottom: 0; }

.anim-up { animation: fadeUp 0.45s ease both; }

/* 会话卡片 */
.conv {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 22rpx rgba(45, 42, 38, 0.06), 0 1rpx 3rpx rgba(45, 42, 38, 0.04);
}
.conv:active { background: #FAF7F1; }

/* 对话气泡图标 */
.conv-icon {
  width: 76rpx; height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #E3EFEA, #F2F7F5);
  border: 1rpx solid rgba(20, 107, 90, 0.12);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 10rpx;
  flex-shrink: 0; margin-right: 26rpx;
}
.ci-line { width: 36rpx; height: 6rpx; border-radius: 3rpx; background: #146B5A; opacity: 0.7; }
.ci-line-short { width: 24rpx; }

.conv-main { flex: 1; min-width: 0; }
.conv-title { font-size: 30rpx; font-weight: 500; margin-bottom: 6rpx; }
.conv-actions { display: flex; align-items: center; flex-shrink: 0; }
.del-btn { color: #C9C2B4; font-size: 24rpx; margin-left: 16rpx; padding: 10rpx 6rpx; transition: color 0.15s ease; }
.del-btn:active { color: #B4492E; }
