/* pages/chat/index.wxss */
.page { padding-bottom: 160rpx; }

.empty { text-align: center; padding: 140rpx 28rpx 60rpx; }
.empty-text { font-size: 32rpx; font-weight: 600; margin: 0 0 8rpx; }

.conv {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0F0EE;
}
.conv:active { background: #F7F7F5; }
.conv-title { font-size: 30rpx; margin-bottom: 6rpx; }
.conv-actions { display: flex; align-items: center; }
.del-btn { color: #D44C47; font-size: 24rpx; margin-left: 16rpx; padding: 8rpx; }

.fab {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #37352F;
  color: #fff;
  font-size: 30rpx;
  padding: 22rpx 56rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(55, 53, 47, 0.18);
}
.fab:active { opacity: 0.9; }
