<view class="chat-page">
  <!-- 模式开关 -->
  <view class="mode-bar">
    <view class="mode-label">
      <view class="mode-dot"></view>
      <text class="sub-text">{{mode === 'doc' ? '单文档问答' : '全局问答'}}</text>
    </view>
    <view class="search-only">
      <text class="sub-text">仅检索</text>
      <switch checked="{{searchOnly}}" bindchange="toggleSearchOnly" color="#146B5A" style="transform: scale(0.7)" />
    </view>
  </view>

  <scroll-view scroll-y enhanced class="msg-list" scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <!-- 欢迎页 -->
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-art">
        <view class="wa-box"></view>
        <view class="wa-tag"></view>
        <view class="wa-line w1"></view>
        <view class="wa-line w2"></view>
      </view>
      <view class="welcome-title">向资料库提问</view>
      <view class="sub-text">回答带引用溯源，点引用可查看原文</view>
      <view class="quick-list">
        <view class="quick-item" bindtap="quickAsk" data-q="总结一下我资料库里的内容">
          <text class="qi-mark">✦</text>
          <text>总结一下资料库里的内容</text>
        </view>
        <view class="quick-item" bindtap="quickAsk" data-q="文档里提到了哪些功能？">
          <text class="qi-mark">✦</text>
          <text>文档里提到了哪些功能？</text>
        </view>
        <view class="quick-item" bindtap="quickAsk" data-q="有哪些版本规划？">
          <text class="qi-mark">✦</text>
          <text>有哪些版本规划？</text>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
          id="msg-{{index}}">
      <!-- AI 侧档案盒小图标 -->
      <view wx:if="{{item.role === 'assistant'}}" class="msg-avatar">
        <view class="av-box"></view>
        <view class="av-tag"></view>
      </view>

      <view class="bubble">
        <text wx:if="{{item.role === 'user' && item.content}}" user-select>{{item.content}}</text>
        <rich-text wx:elif="{{item.role === 'assistant' && item.nodes && item.nodes.length > 0}}"
                   nodes="{{item.nodes}}" selectable />
        <view wx:elif="{{item.streaming}}" class="thinking">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <!-- 流式打字光标 -->
        <view wx:if="{{item.streaming && item.content}}" class="caret"></view>

        <!-- 引用胶囊 -->
        <view wx:if="{{item.citations && item.citations.length > 0}}" class="cites">
          <view class="cite-item" wx:for="{{item.citations}}" wx:for-item="c" wx:for-index="ci"
                wx:key="chunk_id" data-cidx="{{ci}}" data-msgidx="{{index}}" bindtap="onCitationTap">
            <text class="cite-idx">{{ci + 1}}</text>
            <text class="cite-name">{{c.doc_name}}</text>
            <text class="cite-page" wx:if="{{c.page_no}}">p{{c.page_no}}</text>
          </view>
        </view>
      </view>

      <!-- AI 回答操作栏：赞/踩/复制/重新生成 -->
      <view wx:if="{{item.role === 'assistant' && item.content && !item.streaming}}" class="msg-actions">
        <text class="act {{item.feedback === 'like' ? 'act-like' : ''}}" catchtap="toggleFeedback"
              data-msgidx="{{index}}" data-val="like">赞</text>
        <text class="act {{item.feedback === 'dislike' ? 'act-dislike' : ''}}" catchtap="toggleFeedback"
              data-msgidx="{{index}}" data-val="dislike">踩</text>
        <text class="act" catchtap="copyAnswer" data-msgidx="{{index}}">复制</text>
        <text wx:if="{{index === messages.length - 1 && !sending}}" class="act act-regen" catchtap="regenerate">重新生成</text>
      </view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <textarea class="input-box" value="{{input}}" bindinput="onInput"
              placeholder="输入你的问题…" auto-height maxlength="2000"
              confirm-type="send" bindconfirm="send" />
    <view class="send-btn {{sending ? 'btn-disabled' : ''}}" bindtap="send">
      <text wx:if="{{sending}}" class="send-dots"><text class="sd"></text><text class="sd"></text><text class="sd"></text></text>
      <text wx:else>发送</text>
    </view>
  </view>
</view>
