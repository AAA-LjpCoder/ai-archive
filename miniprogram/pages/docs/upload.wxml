<view class="page">
  <view class="card upload-card">
    <view class="section-title">选择文件</view>
    <view class="file-box" bindtap="chooseFile">
      <view wx:if="{{!fileName}}" class="file-empty">
        <view class="file-empty-icon">
          <view class="fe-box"></view>
          <view class="fe-tag"></view>
        </view>
        <view class="file-empty-text">点击选择文件</view>
        <view class="sub-text">txt / md / pdf / docx / pptx / xlsx / epub / html / csv</view>
        <view class="sub-text">单文件 ≤ 20MB</view>
      </view>
      <view wx:else class="file-name">{{fileName}}</view>
    </view>
    <view class="btn-primary {{uploading ? 'btn-disabled' : ''}}" bindtap="upload">
      {{uploading ? '上传解析中…' : '开始上传'}}
    </view>
    <view class="sub-text tips">
      上传后自动解析建索引，处理完成即可提问。加密或损坏的文件会提示失败。
    </view>
  </view>

  <!-- 支持格式 -->
  <view class="card">
    <view class="section-title">支持的格式</view>
    <view class="fmt-grid">
      <view class="fmt-item" wx:for="{{formats}}" wx:key="*this">
        <text class="fmt-dot {{item.cls}}"></text>
        <text class="fmt-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
