.doc-title { font-size: 34rpx; font-weight: 600; margin-bottom: 8rpx; word-break: break-all; }
.status-line { margin: 16rpx 0; display: flex; align-items: center; gap: 12rpx; }
.fail-reason { color: #D92D20; font-size: 24rpx; margin-bottom: 12rpx; word-break: break-all; }
.del { color: #D92D20; border-color: #D92D20; }

.chunk { border-bottom: 2rpx solid #F0F1F3; padding: 16rpx 0; }
.chunk-meta { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.chunk-content { font-size: 26rpx; color: #4B5563; line-height: 1.6; }
