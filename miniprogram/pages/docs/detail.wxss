/* pages/docs/detail.wxss */
.doc-title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; word-break: break-all; }
.doc-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.fail-reason { color: #B4492E; font-size: 24rpx; margin: 12rpx 0; word-break: break-all; }
.del { color: #B4492E; border-color: #B4492E; }

.chunk { border-bottom: 1rpx solid #EFEBE4; padding: 16rpx 0; }
.chunk:last-child { border-bottom: none; }
.chunk-meta { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.chunk-content { font-size: 26rpx; color: #57534A; line-height: 1.6; }
