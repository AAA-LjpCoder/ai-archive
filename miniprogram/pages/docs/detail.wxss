/* pages/docs/detail.wxss — 文档详情 V2 */
.page { padding-bottom: 60rpx; }

/* 头卡 */
.head-card { padding: 34rpx 32rpx; }
.head-top { display: flex; align-items: center; gap: 26rpx; }
.head-icon {
  position: relative;
  width: 76rpx; height: 92rpx;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.14);
  overflow: hidden;
}
.head-icon::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 10rpx;
  background: rgba(255, 255, 255, 0.92);
}
.doc-fold {
  position: absolute; right: 0; bottom: 0;
  width: 0; height: 0;
  border-left: 22rpx solid transparent;
  border-bottom: 22rpx solid rgba(0, 0, 0, 0.14);
}
.doc-label { font-size: 20rpx; font-weight: 800; color: #fff; }
.icon-md { background: linear-gradient(160deg, #4E8CFF, #2563EB); }
.icon-pdf { background: linear-gradient(160deg, #F87171, #DC2626); }
.icon-docx { background: linear-gradient(160deg, #5B8DEF, #1D4ED8); }
.icon-txt { background: linear-gradient(160deg, #A39A8C, #6B7280); }
.icon-pptx { background: linear-gradient(160deg, #FB923C, #EA580C); }
.icon-xlsx { background: linear-gradient(160deg, #4ADE80, #16A34A); }
.icon-epub { background: linear-gradient(160deg, #C084FC, #7C3AED); }
.icon-html { background: linear-gradient(160deg, #22D3EE, #0891B2); }
.icon-csv { background: linear-gradient(160deg, #94A3B8, #64748B); }

.head-main { flex: 1; min-width: 0; }
.doc-title { font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; word-break: break-all; line-height: 1.4; }
.doc-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }

.head-chunks {
  margin-top: 22rpx;
  background: #F7F5F0;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  display: flex; align-items: baseline;
}
.chunk-num { font-size: 40rpx; font-weight: 800; color: #B7791F; }

.fail-reason { color: #B4492E; font-size: 24rpx; margin: 14rpx 0; word-break: break-all; }
.del { color: #B4492E; border-color: #B4492E; }

/* 分块预览 */
.chunk {
  border-bottom: 1rpx solid #EFEBE4;
  padding: 18rpx 0;
  transition: background 0.15s ease;
}
.chunk:last-child { border-bottom: none; }
.chunk-meta { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; flex-wrap: wrap; }
.heading-path { color: #B7791F; }
.chunk-content { font-size: 26rpx; color: #57534A; line-height: 1.65; }
