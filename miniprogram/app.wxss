/* app.wxss — 全局设计系统 V2（档案盒主题：墨绿 + 米白 + 金棕）
   设计语言：纸张质感 · 档案袋卡片 · 细腻动效 */

page {
  background: #FAF8F5;
  font-size: 28rpx;
  color: #2D2A26;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 卡片：纸张质感 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(45, 42, 38, 0.06), 0 1rpx 3rpx rgba(45, 42, 38, 0.04);
  position: relative;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.card:active {
  transform: scale(0.985);
  box-shadow: 0 3rpx 12rpx rgba(45, 42, 38, 0.08);
}

/* ---------- 顶部品牌区（三个 tab 页共用） ---------- */
.hero {
  margin: 20rpx 24rpx 4rpx;
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #E9F3EE 0%, #F5F0E2 55%, #FBF7EC 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.8), 0 6rpx 20rpx rgba(45,42,38,0.05);
}
/* 顶部光斑装饰 */
.hero::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(20,107,90,0.10), transparent 70%);
}
.hero-title { font-size: 46rpx; font-weight: 700; color: #146B5A; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; color: #7A7266; margin-top: 10rpx; }

/* 档案盒插画 */
.hero-art { position: relative; width: 132rpx; height: 132rpx; flex-shrink: 0; }
.hero-art .art-box {
  position: absolute; right: 0; bottom: 0;
  width: 96rpx; height: 108rpx;
  border: 4rpx solid rgba(20, 107, 90, 0.22);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 8rpx 20rpx rgba(20, 107, 90, 0.12);
}
.hero-art .art-tag {
  position: absolute; right: 30rpx; top: 4rpx;
  width: 40rpx; height: 26rpx;
  background: linear-gradient(180deg, #D99A3D, #B7791F);
  border-radius: 6rpx 6rpx 0 0;
}
.hero-art .art-line {
  position: absolute; left: 50%; transform: translateX(-50%);
  width: 56rpx; height: 5rpx; border-radius: 3rpx;
  background: rgba(20, 107, 90, 0.18);
}
.hero-art .art-line.l1 { bottom: 44rpx; }
.hero-art .art-line.l2 { bottom: 30rpx; width: 44rpx; }

/* ---------- 空态 ---------- */
.empty { text-align: center; padding: 90rpx 28rpx 50rpx; animation: fadeUp 0.4s ease both; }
.empty-text { font-size: 32rpx; font-weight: 600; margin: 0 0 8rpx; }

.empty-art { position: relative; width: 120rpx; height: 128rpx; margin: 0 auto 28rpx; }
.empty-art .ea-box {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx; height: 118rpx;
  border: 4rpx solid #D9D2C5;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(45,42,38,0.08);
}
.empty-art .ea-line {
  position: absolute; left: 50%; transform: translateX(-50%);
  width: 56rpx; height: 6rpx; border-radius: 3rpx;
  background: #E7E1D5;
}
.empty-art .ea-line.l1 { top: 40rpx; }
.empty-art .ea-line.l2 { top: 60rpx; width: 44rpx; }
.empty-art .ea-line.l3 { top: 80rpx; width: 56rpx; }
.empty-art .ea-corner {
  position: absolute; right: 8rpx; top: 8rpx;
  width: 20rpx; height: 20rpx;
  background: linear-gradient(135deg, #D99A3D, #B7791F);
  border-radius: 4rpx;
  opacity: 0.9;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  margin: 16rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(20, 107, 90, 0.25);
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }

.btn-gold {
  background: linear-gradient(135deg, #B7791F, #D99A3D);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  margin: 16rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(183, 121, 31, 0.28);
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.btn-gold:active { opacity: 0.88; transform: scale(0.98); }

.btn-plain {
  background: #fff;
  color: #146B5A;
  border: 2rpx solid #146B5A;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin: 16rpx 0;
  transition: background 0.15s ease;
}
.btn-plain:active { background: #F2F7F5; }

.btn-disabled { background: #E4E0D8 !important; color: #A8A296 !important; box-shadow: none !important; }

.section-title { font-size: 28rpx; font-weight: 600; margin: 8rpx 0 12rpx; color: #2D2A26; }
.sub-text { color: #9B9488; font-size: 24rpx; }

.textarea-box {
  width: 100%;
  min-height: 240rpx;
  background: #F3EFE9;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}
.tag-green { background: #E3EFEA; color: #146B5A; }
.tag-red { background: #F8E9E4; color: #B4492E; }
.tag-gray { background: #F1EDE7; color: #8A8075; }
.tag-gold { background: #F7EFE3; color: #B7791F; }

/* 文档类型着色 */
.tag-type-md { background: #E8F0FE; color: #2563EB; }
.tag-type-pdf { background: #FDE8E8; color: #DC2626; }
.tag-type-docx { background: #E8EEFD; color: #1D4ED8; }
.tag-type-txt { background: #F1F1EF; color: #6B7280; }

/* ---------- 浮动按钮 ---------- */
.fab {
  position: fixed; bottom: 60rpx; left: 50%; transform: translateX(-50%);
  background: linear-gradient(135deg, #146B5A, #1E8873);
  color: #fff; font-size: 30rpx; font-weight: 500;
  padding: 24rpx 60rpx; border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(20, 107, 90, 0.32), 0 2rpx 8rpx rgba(20, 107, 90, 0.2);
  transition: transform 0.15s ease;
  z-index: 50;
}
.fab:active { transform: translateX(-50%) scale(0.96); }

/* ---------- 动画基元 ---------- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}
@keyframes scanline {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(400%); }
}
@keyframes pulseSoft {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #F0ECE4 25%, #FAF7F1 50%, #F0ECE4 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.4s infinite linear;
  border-radius: 12rpx;
}
