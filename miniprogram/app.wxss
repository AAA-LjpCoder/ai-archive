/* app.wxss — 全局样式（极简文档风：白底、细分割线、无阴影、小圆角） */
page {
  background: #FFFFFF;
  font-size: 28rpx;
  color: #37352F;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 卡片：无阴影，仅细边框，小圆角 */
.card {
  background: #fff;
  border: 1rpx solid #EBEBE7;
  border-radius: 8rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
}

.btn-primary {
  background: #2383E2;
  color: #fff;
  border-radius: 6rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin: 16rpx 0;
}

.btn-primary:active { opacity: 0.85; }

.btn-plain {
  background: #fff;
  color: #37352F;
  border: 1rpx solid #D3D1CB;
  border-radius: 6rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  margin: 16rpx 0;
}

.btn-disabled { background: #F1F1EF; color: #C7C7C4; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 12rpx;
}

.sub-text { color: #9B9A97; font-size: 24rpx; }

.textarea-box {
  width: 100%;
  min-height: 240rpx;
  background: #F7F7F5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-blue { background: #E7F3F8; color: #2383E2; }
.tag-green { background: #E3F1E8; color: #448361; }
.tag-gray { background: #F1F1EF; color: #787774; }
.tag-red { background: #FBE9E9; color: #D44C47; }
