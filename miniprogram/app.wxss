/* app.wxss — 全局样式 */
page {
  background: #F5F7FA;
  font-size: 28rpx;
  color: #1F2329;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #1F6FEB;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  margin: 16rpx 0;
}

.btn-primary:active { opacity: 0.85; }

.btn-plain {
  background: #fff;
  color: #1F6FEB;
  border: 2rpx solid #1F6FEB;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  margin: 16rpx 0;
}

.btn-disabled { background: #C9CDD4; color: #fff; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 8rpx 0 12rpx;
}

.sub-text { color: #8A9099; font-size: 24rpx; }

.textarea-box {
  width: 100%;
  min-height: 240rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-blue { background: #E8F0FE; color: #1F6FEB; }
.tag-green { background: #E6F7ED; color: #22A06B; }
.tag-gray { background: #F0F1F3; color: #6B7280; }
.tag-red { background: #FDECEC; color: #D92D20; }
